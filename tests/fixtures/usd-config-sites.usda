#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "World" {
    def Xform "Lab" {
        def Xform "Robot" (prepend apiSchemas = ["PhysicsArticulationRootAPI"]) {
            def Xform "Base" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]) {
                double3 xformOp:translate = (0, 0, 1)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                float physics:mass = 1
            }
            def Xform "Link" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]) {
                double3 xformOp:translate = (0, 0, 1)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                float physics:mass = 1
                def Cube "Collider" (prepend apiSchemas = ["PhysicsCollisionAPI"]) {
                    double size = 0.1
                }
                def Sphere "TCP" {
                    double radius = 0.01
                    double3 xformOp:translate = (1, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                }
            }
            def PhysicsFixedJoint "Anchor" {
                rel physics:body1 = </World/Lab/Robot/Base>
                point3f physics:localPos0 = (0, 0, 1)
            }
            def PhysicsRevoluteJoint "Joint" {
                rel physics:body0 = </World/Lab/Robot/Base>
                rel physics:body1 = </World/Lab/Robot/Link>
                uniform token physics:axis = "Z"
                float physics:lowerLimit = -90
                float physics:upperLimit = 90
            }
        }
        def Mesh "Target" {
            point3f[] points = [(-0.01, -0.01, 0), (0.01, -0.01, 0), (0, 0.01, 0)]
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            uniform token subdivisionScheme = "none"
            double3 xformOp:translate = (1, 0, 1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Sphere "Existing" (prepend apiSchemas = ["NewtonSiteAPI"]) {
            double radius = 0.01
            double3 xformOp:translate = (1, 0, 1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
