{
  "schema": "lw.cell-passage-client/1",
  "workcellType": "cell-passage-workcell/v1",
  "centrifugeCycleReceipt": {
    "schema": "lw.centrifuge-cycle-receipt/1",
    "stages": [3, 4],
    "stoppedSpeedRadPerSecond": 0.05,
    "minimumRunSeconds": 2,
    "lookup": "Plan stepResults[str(stepId)].invocationId -> existing session invocation GET",
    "missingEvidence": "unavailable; never infer from Plan done or reissue the action"
  },
  "quantityTolerances": {
    "cellConservation": 0.000001,
    "siblingLive": 1,
    "finalVolumeUl": 0.01
  },
  "mechanicalTolerances": {
    "positionM": 0.005,
    "orientationDegrees": 5,
    "relativeSpeedMps": 0.01,
    "basis": "Existing labware.facts seated_station thresholds, in native physics coordinates"
  },
  "liquidActions": {
    "literal": ["aspirate", "dispense", "mix"],
    "quantityIntent": ["aspirateAvailable", "aspirateFraction", "aspirateTopUp", "dispenseAll"],
    "aspiration": ["aspirate", "aspirateAvailable", "aspirateFraction", "aspirateTopUp"],
    "dispensing": ["dispense", "dispenseAll"],
    "mixing": ["mix"],
    "failedRemainder": {
      "replayQuantityIntent": false,
      "replacement": "Review the original resolved goal, actual applied amount and present material; use an explicit literal remainder or a reviewed check, with a new operation ID",
      "reviewFields": ["quantityKind", "requestedUl", "resolvedUl", "appliedUl", "observedUl", "remainingUl", "resolutionResidualUl", "untransferredUl", "resolutionUl", "pumpStartM", "pumpTargetM", "quantityOutcome", "remainderLocation"]
    }
  },
  "roundPlanIdentity": {
    "idTemplate": "cp-{roundId}-stage{stage}-part{part}-of{parts}",
    "titleTemplate": "Cell Passage {roundId} · {stage}/7 · {stageTitle} · part {part}/{parts}",
    "maxPartSteps": 128,
    "ordering": "stage ascending, then part ascending; all seven stages and every declared part are required",
    "stepIdentity": "Global step IDs persist; done and unchanged unstarted pending operation IDs persist; replacements get a new operation ID",
    "operationReferences": ["pellet.params.cycle", "completedCycle.equals", "lastOperationId.equals"],
    "requestIdentity": "One request ID per dispatch attempt; an unanswered attempt is observed without reposting; a new owner/revision attempt gets a new request ID"
  },
  "stages": [
    {"id": 1, "name": "retrieve-observe", "title": "取出与观察", "firstStep": 100001, "lastStep": 199999},
    {"id": 2, "name": "prepare-collect", "title": "清洗、解离与逐份收集", "firstStep": 200001, "lastStep": 299999},
    {"id": 3, "name": "centrifuge-first", "title": "首批四份离心", "firstStep": 300001, "lastStep": 399999},
    {"id": 4, "name": "centrifuge-second", "title": "第二批两份及配平管离心", "firstStep": 400001, "lastStep": 499999},
    {"id": 5, "name": "resuspend-count", "title": "逐份重悬、取样与计数", "firstStep": 500001, "lastStep": 599999},
    {"id": 6, "name": "reseed", "title": "十二子孔均分接种与补液", "firstStep": 600001, "lastStep": 699999},
    {"id": 7, "name": "incubate-cleanup", "title": "回培养与废物收尾", "firstStep": 700001, "lastStep": 799999}
  ],
  "reconciliation": {
    "cell-passage-workcell/v1": {
      "observedProperties": ["controlOwner", "controlEpoch", "controlMode", "controlSafe", "phase", "materialRevision", "auditPassed", "inFlightUl", "operationCount", "terminalOperationCount", "archivedOperationCount"],
      "safeEquals": {"controlSafe": true, "auditPassed": true}
    },
    "labware-motion/v1": {
      "observedProperties": ["controlSafe", "phase", "holding", "atLocation", "zone", "gripperWidth", "jointPositions", "tcpPose"],
      "safeEquals": {"controlSafe": true}
    },
    "labware/v1": {
      "observedProperties": ["station", "location", "settled", "lidClosed"],
      "safeEquals": {}
    },
    "passage-joint/v1": {
      "observedProperties": ["position", "velocity", "opened", "closed", "controlSafe", "phase"],
      "safeEquals": {"controlSafe": true}
    },
    "passage-centrifuge/v1": {
      "observedProperties": ["phase", "lidOpen", "rpm", "actualRpm", "remainingSeconds", "slots", "loadSafe", "completedCycle", "cycleRunSeconds", "actualRotorTurns", "controlSafe", "completedLoad", "loadedEntities", "modeledMassKg"],
      "safeEquals": {"controlSafe": true}
    },
    "passage-incubator/v1": {
      "observedProperties": ["temperatureC", "co2Percent", "humidityPercent", "setpointC", "humiditySetpointPercent", "temperatureReadyRangeC", "co2ReadyRangePercent", "humidityReadyRangePercent", "doorOpen", "doorKnown", "environmentReady", "phase", "waitElapsedSeconds", "controlSafe", "signalSource"],
      "safeEquals": {"controlSafe": true, "doorKnown": true}
    },
    "passage-cabinet/v1": {
      "observedProperties": ["inflowMs", "sashHeightCm", "uvOn", "blowerOn", "cabinetReady", "controlSafe", "signalSource"],
      "safeEquals": {"controlSafe": true, "cabinetReady": true}
    }
  }
}
