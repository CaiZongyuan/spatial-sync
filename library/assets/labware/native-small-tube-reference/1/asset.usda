#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def Cylinder "Visual1"
    {
        uniform token axis = "Z"
        double height = 0.029999999329447746
        double radius = 0.00800000037997961
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.014999999664723873)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Cube "Visual2"
    {
        double size = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.01, 0.01, 0.004)
        double3 xformOp:translate = (0, 0, 0.0020000000949949026)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}
