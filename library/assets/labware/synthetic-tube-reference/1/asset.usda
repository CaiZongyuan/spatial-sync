#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def Cylinder "Visual1"
    {
        uniform token axis = "Z"
        double height = 0.08
        double radius = 0.008
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }
}

